rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Putzplan: eine Woche = ein Dokument, ID = Montag der Woche (z. B. 2026-10-19)
    match /weeks/{week} {
      allow read: if true;
      allow write: if week.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.keys().hasOnly(['done', 'swap'])
        && request.resource.data.done is map
        && request.resource.data.swap is map
        && request.resource.data.done.keys().hasOnly(['bad1', 'bad2', 'kueche', 'flur', 'saugen1', 'saugen2', 'extra'])
        && request.resource.data.swap.keys().hasOnly(['bad1', 'bad2', 'kueche', 'flur', 'extra']);
    }
    // Einkaufsliste: ein Dokument pro Eintrag
    match /einkauf/{item} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'by', 'at', 'bought', 'boughtBy', 'boughtAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.bought is bool;
    }
    // WG-Kasse: ein Dokument pro Auslage, Einzahlung oder Korrektur des Kassenstands, Beträge in Cent
    match /kasse/{entry} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['type', 'person', 'cents', 'note', 'at', 'paid', 'paidAt', 'target'])
        && request.resource.data.type in ['auslage', 'einzahlung', 'korrektur']
        && request.resource.data.person in ['Flo', 'Yurai', 'Son', 'Dominik', 'Bram', '']
        && request.resource.data.cents is int
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 80
        && request.resource.data.paid is bool
        && ((request.resource.data.type != 'korrektur'
              && request.resource.data.person != ''
              && request.resource.data.cents > 0
              && request.resource.data.cents <= 100000)
          || (request.resource.data.type == 'korrektur'
              && request.resource.data.cents != 0
              && request.resource.data.cents >= -1000000
              && request.resource.data.cents <= 1000000
              && request.resource.data.target is int
              && request.resource.data.target >= 0));
    }
    // Monatsbeiträge: ein Dokument pro Monat (z. B. 2026-11), darin pro Person Zeitpunkt und Betrag
    match /beitraege/{month} {
      allow read: if true;
      allow write: if month.matches('^\\d{4}-\\d{2}$')
        && request.resource.data.keys().hasOnly(['paid'])
        && request.resource.data.paid is map
        && request.resource.data.paid.keys().hasOnly(['Flo', 'Yurai', 'Son', 'Dominik', 'Bram']);
    }
    // Einstellungen: Höhe des Monatsbeitrags in Cent
    match /einstellungen/kasse {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['beitrag'])
        && request.resource.data.beitrag is int
        && request.resource.data.beitrag > 0
        && request.resource.data.beitrag <= 100000;
    }
    // Alles andere ist gesperrt
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
